    given-names: Paula
    affiliation: "I2SysBio (University of Valencia - CSIC)"
  - family-names: Coscolla
    given-names: Mireia
    affiliation: "I2SysBio (University of Valencia - CSIC)"
repository-code: "https://github.com/PathoGenOmics-Lab/BAMpiro"
url: "https://github.com/PathoGenOmics-Lab/BAMpiro"
license: GPL-3.0
version: 1.1.0
# Add `doi:` here once the release is archived on Zenodo (mints a persistent software DOI).
keywords:
  - bioinformatics
  - Nextflow
  - variant-calling
  - Mycobacterium tuberculosis
  - drug-resistance
  - quality-control
