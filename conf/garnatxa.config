/*
 * ============================================================================
 *  BAMpiro - site configuration for GARNATXA (SLURM, I2SysBio / University of Valencia)
 * ============================================================================
 *  Applied by `-profile garnatxa`, so a run on that cluster needs nothing else:
 *
 *      nextflow run PathoGenOmics-Lab/BAMpiro -r 1.0.2 \
 *          --tsv samples.tsv --outdir results -profile garnatxa
 *
 *  Combine it with the option profiles as usual, e.g. `-profile garnatxa,generic`
 *  for a non-tuberculosis organism.
 *
 *  Everything here is specific to one cluster: its paths, its QoS names and its
 *  module system. Use it as the template for your own site, and note that only the
 *  DRIVER needs a long-running allocation; the values below apply to the tasks.
 * ============================================================================
 */

process {
    executor       = 'slurm'
    clusterOptions = "--qos=${params.qos}"
    beforeScript   = 'module load singularity'

    // Ask for the time a task actually needs. Without a `time` directive every job inherits the
    // QoS default, which on this cluster is SIX HOURS, and SLURM's backfill scheduler can only
    // slot a job into a gap longer than the walltime it requested. A 200 ms COLLECT_DR asking for
    // six hours therefore queues behind everything instead of filling the next gap. Measured
    // against a real cohort, the slowest step was ten minutes and most were under thirty seconds.
    //
    // Scaled by task.attempt so a timeout heals itself: SLURM sends SIGTERM, the task exits 143,
    // and the retry policy in nextflow.config already covers that with maxRetries 3.
    //
    // Check `sacctmgr show qos format=name,maxwall` for your account before raising these: a
    // request above the QoS MaxWall is rejected at submission rather than queued.
    time = { 30.min * task.attempt }

    // The long steps. They sat on a separate QoS because Kraken took ten minutes against a 133 GB
    // database; the other two never needed it, having been measured at about twenty seconds each.
    // Both knobs default to the same queue, so this only separates them when you set --qos_heavy.
    withName: 'MERGE_AND_MARKDUP|CALL_FREEBAYES|KRAKEN_FILTER_.*' {
        clusterOptions = "--qos=${params.qos_heavy}"
        time           = { 1.h * task.attempt }
    }

    // Local scratch on the compute nodes is much faster than the shared filesystem;
    // Nextflow stages the outputs back to the work directory on completion.
    scratch = true
}

executor {
    queueSize       = 200      // concurrent jobs from one run
    submitRateLimit = '50/1min'
    pollInterval    = '30s'
}

singularity {
    // A task only sees the host paths bound into it. autoMounts covers the work and launch
    // directories; everything else (reads, references, the Kraken database, and the pipeline
    // itself when Nextflow pulls it into $HOME/.nextflow/assets) has to be listed here.
    // Comma-separated, no spaces, and bind PARENT directories.
    //
    // /storage/pgo is the group's sequencing store, which is where the reads actually live.
    runOptions = "--bind /scr/ruizro,/storage/pgo,/storage/shared_datasets," +
                 "${System.getenv('HOME') ?: '/home'}" +
                 "${params.extra_binds ? ',' + params.extra_binds : ''}"
}

params {
    // Shared Kraken2 database on this cluster (~80 GB resident, the run's memory ceiling).
    kraken2_db = '/storage/shared_datasets/kraken2'

    // The per-reference mappability track is computed once and reused. An absolute, shared path
    // means every future run on this cluster skips that step.
    mappability_dir = '/scr/ruizro/test_pipes/bampiro/mappability_cache'
}

// Keep the work directory on scratch: never on $HOME, which is quota-limited and slow, and which
// -resume needs to stay intact.
workDir = '/scr/ruizro/test_pipes/bampiro/work'
