/*
 * ============================================================================
 *  BAMpiro — configuration template for a NON-tuberculosis organism
 * ============================================================================
 *  BAMpiro's built-in defaults are tuned for Mycobacterium tuberculosis. Copy
 *  this file, edit the values for YOUR organism, and layer it on top of the
 *  defaults with -c:
 *
 *      nextflow run main.nf --tsv samples.tsv --outdir results \
 *          -profile standard -c conf/organism.config
 *
 *  For just the haploid-bacterium essentials (ploidy 1 + the MTBC-only features
 *  forced off) you can instead use the built-in profile — no file needed:
 *
 *      nextflow run main.nf --tsv samples.tsv --outdir results -profile standard,generic
 *
 *  Add this file only when you also want to change the Kraken DB, a canonical
 *  numbering, or the QC gate thresholds. Everything below is optional; delete
 *  the lines you don't need (an absent param keeps its default).
 * ============================================================================
 */

params {

    // --- Ploidy -------------------------------------------------------------
    // TB uses ploidy 2 to catch mixed infections / heteroresistance. For a
    // clonal haploid bacterium use 1 (cleaner, no spurious heterozygous calls).
    // Keep 2 only if you want within-sample (polyclonal) variant detection.
    freebayes_ploidy = 1

    // --- Reference ----------------------------------------------------------
    // The reference is per-sample in the samplesheet (refId / refFasta / refGff),
    // so there is nothing to set here — just point those columns at YOUR genome
    // and GFF. A GFF with gene features drives SnpEff annotation and the
    // report's gene panels.

    // --- Taxonomic filtering (Kraken2) -------------------------------------
    // Point kraken2_db at a DB that covers your organism, and put its NCBI
    // TaxID in the samplesheet `taxId` column (e.g. 562 = E. coli,
    // 1280 = S. aureus, 573 = K. pneumoniae, 1773 = M. tuberculosis).
    kraken2_db = "/path/to/kraken2_db"

    // --- Dual amino-acid numbering (optional) ------------------------------
    // OFF by default. If your organism has a canonical reference you want a
    // second amino-acid numbering against, build/point a SnpEff DB and enable:
    //   annotate_canonical  = true
    //   canonical_snpeff_db = "Escherichia_coli_str_k_12_substr_mg1655"  // a SnpEff genome id
    //   canonical_label     = "K-12"                                     // label shown in the report

    // --- MTBC-only features: leave OFF for a non-TB run --------------------
    // These are Mycobacterium-tuberculosis-specific and meaningless for other
    // organisms; they are off by default (and `-profile generic` also forces
    // them off). Do NOT enable them for a non-TB run:
    run_pathotypr    = false   // MTBC lineage + WHO drug-resistance typing
    variant_liftover = false   // H37Rv coordinate liftover
    mask_blindspots  = false   // H37Rv Illumina blind-spots mask
    // (The report's lineage / drug-resistance panels self-hide when there is no
    //  lineage/DR data, and the MTBC lineage colour palette is simply unused —
    //  harmless — for a non-TB cohort.)

    // --- QC gate thresholds (organism-dependent) ---------------------------
    // Defaults suit a typical bacterium; tune to your depth / genome. All of
    // these are also live-adjustable inside the HTML report.
    //   report_depth_min   = 10   // min mean depth (×)
    //   report_breadth_min = 90   // min genome breadth (%)
    //   report_missing_max = 10   // max missing (%)
    //   report_mapping_min = 80   // min mapped reads (%)
}
