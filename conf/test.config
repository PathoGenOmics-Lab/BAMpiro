/*
 * ============================================================================
 *  BAMpiro - minimal test profile
 * ============================================================================
 *  Runs the bundled fixture cohort (tests/data/: a 5 kb reference, three samples,
 *  one of them single-end and one split over two runs). Intended for `-stub-run`,
 *  which executes each process's `stub:` block instead of the real tool, so the
 *  whole DAG is validated in seconds with no container and no reference data:
 *
 *      nextflow run main.nf -profile test -stub-run
 *
 *  Launch it from the repository root: the fixture samplesheet points at the reads
 *  with repository-relative paths. `tests/run_tests.sh` does that for you.
 *
 *  This profile covers the DEFAULT feature set. For a run that also walks the
 *  optional branches (Kraken, pathotypr, canonical annotation, liftover, virgin
 *  consensus) use `-profile test_full`.
 * ============================================================================
 */

params {
    tsv    = "${projectDir}/tests/data/samplesheet.tsv"
    outdir = "results_test"

    // No Kraken database in the fixtures: main.nf warns and disables the branch.
    kraken2_db = null

    // The fixture genome is 5 kb at ~30x, far below the production defaults, so the
    // thresholds are relaxed to keep the QC gate meaningful rather than always red.
    filter_min_dp   = 1
    allpos_min_cov  = 1
    consensus_min_dp = 1
    report_depth_min = 1
    report_gate      = false

    // The k sweep is a per-reference cost that dominates a tiny test run.
    genmap_max_k = 100
    genmap_step  = 25

    // BUILD_MAPPABILITY uses storeDir, so a shared cache would make the second run skip it and
    // the test would stop covering that process. Keep the cache inside the throwaway directory
    // that tests/run_tests.sh clears, so every run is cold and hermetic.
    mappability_dir = "${projectDir}/.test_cache/mappability"
}

process {
    executor       = 'local'
    beforeScript   = ''
    clusterOptions = ''
    scratch        = false

    // Cap the per-process requests declared in nextflow.config (up to 32 GB) so the
    // run fits a 2-core CI runner instead of queueing forever against a 7 GB host.
    resourceLimits = [ cpus: 2, memory: 4.GB, time: 30.m ]
}

// A stub run executes plain shell in the task directory; no image needed.
singularity.enabled = false
docker.enabled      = false

// Keep the fixture run out of the results tree the pipeline reports on.
timeline.enabled = false
report.enabled   = false
trace.enabled    = false
