/*
 * ============================================================================
 *  BAMpiro - end-to-end test profile
 * ============================================================================
 *  A real run, script blocks and all, of the simulated cohort tests/e2e/cohort.py
 *  writes. tests/e2e/test_e2e.py generates the cohort, runs the pipeline with this
 *  profile on top of `docker`, and holds every output against what the cohort
 *  planted:
 *
 *      BAMPIRO_E2E=1 python -m pytest tests/e2e -q
 *
 *  The samplesheet and the output directory are given on the command line, since
 *  the cohort is written to a temporary directory.
 *
 *  Unlike `-profile test`, nothing about the calling is relaxed: the cohort is read
 *  at 100x, so the thresholds a production run applies are the ones under test.
 *  Only the resources are capped, to a GitHub-hosted runner (4 CPUs, 16 GB).
 * ============================================================================
 */

params {
    // No Kraken database: main.nf warns and leaves the branch out, as it does by default.
    kraken2_db = null

    max_cpus   = 4
    max_memory = '12.GB'
    max_time   = '1.h'
}

process {
    executor       = 'local'
    beforeScript   = ''
    clusterOptions = ''
    scratch        = false
}
