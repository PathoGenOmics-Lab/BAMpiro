/*
 * ============================================================================
 *  BAMpiro - test profile with every optional branch ON
 * ============================================================================
 *  Layered on top of conf/test.config. It switches on the features that are OFF by
 *  default so a single stub run instantiates EVERY process in the pipeline:
 *  Kraken filtering, pathotypr lineage + DR typing, canonical (H37Rv) annotation,
 *  the k-mer coordinate liftover, and the virgin (unmasked) consensus path.
 *
 *      nextflow run main.nf -profile test_full -stub-run
 *
 *  The paths below point at fixtures, not at real panels. They exist only so
 *  Nextflow can stage them; a stub run never reads their contents.
 * ============================================================================
 */

params {
    // Kraken: main.nf enables the branch when the DB path exists AND the samplesheet
    // carries a taxId. The fixture "database" is an empty directory.
    kraken2_db = "${projectDir}/tests/data/kraken2_db"

    // Pathotypr lineage + drug-resistance typing.
    run_pathotypr        = true
    pathotypr_ref        = "${projectDir}/tests/data/pathotypr/reference.fasta"
    pathotypr_markers    = "${projectDir}/tests/data/pathotypr/lineage_markers.tsv"
    pathotypr_dr_markers = "${projectDir}/tests/data/pathotypr/dr_markers.tsv"

    // Dual amino-acid numbering and the k-mer coordinate liftover.
    annotate_canonical = true
    variant_liftover   = true
    canonical_ref      = "${projectDir}/tests/data/pathotypr/reference.fasta"

    // Virgin consensus path: CALL_BACKBONE_RAW, MERGE_VCFS_RAW, CONSENSUS_FASTA_RAW,
    // and (with virgin_full_freebayes) CALL_FREEBAYES_RAW.
    dynamic_read_filter   = true
    keep_virgin_consensus = true
    virgin_full_freebayes = true

    // Blind-spot masking, exercised inside PREPARE_REFERENCE.
    mask_blindspots    = true
    blindspot_liftover = true
}

// Gene conversion. The fixture reference has no paralogs, so a stub run only proves the wiring:
// PARALOG_MAP, FIND_GENE_CONVERSION and COLLECT_GENE_CONVERSION are instantiated and their
// channels join. The detector's behaviour is covered by tests/unit/test_gene_conversion.py.
params.find_gene_conversion = true
// An outgroup so ALIGN_OUTGROUP is instantiated too. The fixture reference stands in for one: a
// stub run executes nothing, and what is under test here is that the channel reaches the process.
params.gconv_outgroup = "${projectDir}/tests/data/reference.fasta"
