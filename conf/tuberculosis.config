/*
 * ============================================================================
 *  BAMpiro — recommended configuration for Mycobacterium tuberculosis (DEFAULT)
 * ============================================================================
 *  M. tuberculosis is BAMpiro's default organism, so the built-in defaults are
 *  already TB-tuned (diploid calling for mixed infections, H37Rv-aware). This
 *  file just turns ON the full recommended MTBC feature set and documents it,
 *  so a TB run is a single, explicit, reproducible command:
 *
 *      nextflow run main.nf --tsv samples.tsv --outdir results \
 *          -profile standard -c conf/tuberculosis.config
 *
 *  (Running with no -c at all already does a valid TB run — it just leaves the
 *  optional MTBC features below OFF. For a NON-TB organism use the `generic`
 *  profile and conf/organism.config instead.)
 *
 *  Everything here needs the BAMpiro container only — the pathotypr binary, the
 *  Zenodo marker panels, the MTBC-ancestor reference and the H37Rv SnpEff DB are
 *  all bundled in the image.
 * ============================================================================
 */

params {

    // --- Variant calling: diploid ------------------------------------------
    // TB is called diploid so within-sample mixtures (mixed infection /
    // heteroresistance) surface as heterozygous calls.
    freebayes_ploidy = 2

    // --- Lineage + drug-resistance typing (pathotypr) ----------------------
    // Alignment-free (k-mer) MTBC lineage + WHO drug-resistance genotyping,
    // reference-agnostic (works even off a non-H37Rv reference).
    run_pathotypr     = true
    pathotypr_min_alt = 95      // near-fixed DR calls only; lower to ~10-25 to catch minority/heteroresistant alleles

    // --- Dual H37Rv amino-acid numbering -----------------------------------
    // Re-annotate variants against the canonical H37Rv SnpEff DB so the report
    // shows each protein change and gene in BOTH the used-reference and H37Rv
    // numbering, with Mycobrowser (Rv...) gene links. Each SNP is lifted to its
    // H37Rv position first, so this holds on any MTBC reference.
    annotate_canonical  = true
    canonical_snpeff_db = "Mycobacterium_tuberculosis_h37rv"   // bundled in the image
    canonical_chrom     = "Chromosome"                         // the name that DB gives H37Rv's chromosome
    canonical_label     = "H37Rv"

    // --- H37Rv COORDINATE per variant (k-mer liftover) ---------------------
    // Fill each variant's H37Rv coordinate for the report's SNP tables,
    // alignment-free — correct even when the mapping reference is not H37Rv,
    // for every reference of the run and every contig of each.
    variant_liftover = true
    // canonical_ref = "/opt/pathotypr/reference.fasta"  // MTBC-ancestor (H37Rv-colinear); the lift target

    // --- Blind-spot masking ------------------------------------------------
    // Mask the H37Rv Illumina blind-spots (Zenodo 3701840); blindspot_liftover
    // (default true) lifts them onto the run reference so the mask is correct
    // on any MTBC reference.
    mask_blindspots = true

    // --- Taxonomic filtering (Kraken2) -------------------------------------
    // Point kraken2_db at a DB covering MTBC and put taxId 1773 in the
    // samplesheet `taxId` column.
    // kraken2_db = "/path/to/kraken2_db"
}
