/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
            BAMpiro Nextflow config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Default config options for the BAMpiro pipeline.
    Combines pipeline parameters and cluster execution logic.
----------------------------------------------------------
*/

// 1. Pipeline Parameters
params {
    // --- Inputs & System ---
    help     = false     // --help lists every parameter with its default, then exits
    // Required. There is no sensible default samplesheet, so the run stops with a clear message.
    tsv      = null
    outdir   = "results_bampiro"
    threads  = 8
    // The image is published to BOTH registries by .github/workflows/docker-publish.yml (same digest):
    //   - Docker Hub  paururo/bampiro                     (public -> the cluster pulls it without auth)
    //   - GHCR        ghcr.io/pathogenomics-lab/bampiro    (kept private for now; needs a read:packages PAT)
    // PINNED BY DIGEST, not by tag: a tag can be repointed at a different image, so two runs a month
    // apart would silently use different tool versions. This digest is the 1.1.0-rc1 image; to move to a new
    // release, publish it and copy the digest the action prints. `--container` overrides it, and the
    // resolved value is recorded in the report's provenance footer either way.
    // For a PRIVATE image export APPTAINER_DOCKER_USERNAME=<gh-user> + APPTAINER_DOCKER_PASSWORD=<PAT read:packages>.
    container = "docker://paururo/bampiro@sha256:78355aa4909dad87c44e2157ccb8032c86d24da3a8e10f37b5075a2b9ba57626"
    
    // --- Resource ceilings ---
    // Each process asks for what its tool actually needs, and Kraken2 asks for 80 GB, which no
    // laptop has: Nextflow would queue that task forever (local executor) or have the scheduler
    // reject it. These cap EVERY request to what the machine can give, so one flag makes the whole
    // pipeline fit rather than editing nine modules. Null means "no cap" (a cluster, where the
    // per-process numbers are the point). Sizes take Nextflow units: '16.GB', '2.h'.
    //     --max_cpus 4 --max_memory 8.GB
    max_cpus   = null
    max_memory = null
    max_time   = null

    // Controls whether sample folders are nested (e.g., MP001 -> MP/00/1)
    // Set to 'true' to enable hierarchical output folders.
    nested_output = true

    // --- Pathotypr Settings (containerised: bioconda `pathotypr`, marker panels from Zenodo v1.0.0) ---
    // Alignment-free (k-mer) MTBC lineage + WHO drug-resistance genotyping. Reference-agnostic: works even
    // when samples are mapped to a non-H37Rv reference. Marker positions are in MTBC-ancestor coordinates.
    run_pathotypr       = false                               // set true to enable lineage + DR typing
    pathotypr_bin       = "pathotypr"                          // on PATH inside the container (was a cluster binary)
    pathotypr_ref       = "/opt/pathotypr/reference.fasta"     // MTBC ancestor fasta the markers are defined on (provide/bundle)
    pathotypr_markers   = "/opt/pathotypr/lineage_markers.tsv" // Zenodo lineage markers (bundled in the image)
    pathotypr_dr_markers = "/opt/pathotypr/dr_markers.tsv"     // Zenodo WHO drug-resistance markers (bundled)
    // NOTE: the RF lineage model (rf_model.pathotypr) is bundled in the image but NOT used: lineage is typed by
    // markers via `split-fastq --nested-classification`, not by `pathotypr predict`. No param exposes it.
    // Minimum alt-allele % for the DR call (pathotypr split-fastq --min-alt-percent). Default 95 = only
    // (near-)fixed mutations; lower it (e.g. 10-25) to also catch heteroresistant / minority DR alleles.
    // The lineage pass keeps pathotypr's default (confident, near-fixed lineage markers).
    pathotypr_min_alt   = 95

    // --- Gene conversion (opt-in) ---
    // Looks for tracts where one paralog has been copied onto another. It deliberately works
    // OUTSIDE the masking: repeat exclusion and the length-aware read filter remove paralogous
    // sequence and multi-mapping reads, which is right for variant calling and removes exactly the
    // signal here. Needs exclude_repeats=true, which is what produces the self-alignment the
    // paralog map is read from. See docs/gene-conversion.md.
    find_gene_conversion    = false
    // An outgroup FASTA, aligned once against the reference. It is what says WHICH copy a
    // difference is on: without it, a sample carrying the donor's base and a reference carrying a
    // derived one are the same picture, and a tract is reported against whichever copy the
    // reference happens to call the acceptor. For MTBC this is the inferred ancestor or any
    // sequence outside the clade being studied. Empty means every polarity column stays empty.
    gconv_outgroup          = ''
    gconv_min_identity      = 90.0   // ignore paralog pairs below this % identity
    gconv_min_paralog_length = 200   // ignore paralog pairs shorter than this (bp)
    // The call is a Bayes factor, not a threshold crossing: every possible tract is weighed
    // against the two other ways an acceptor site shows the donor's base, namely an independent
    // substitution and a read that arrived from the donor. 3 is "decisive" on the usual scale.
    gconv_min_bf            = 3.0    // log10 Bayes factor before a tract is called a conversion
    gconv_report_bf         = 1.0    // log10 Bayes factor below which a tract is not written out
    gconv_prior             = 0.01   // prior that a given paralog pair carries a conversion tract
    gconv_mean_tract_bp     = 1000   // mean of the exponential prior on tract length
    gconv_max_tract_bp      = 10000  // longest tract considered (past this see coverage_shift)
    gconv_max_tracts        = 2      // conversion tracts looked for per paralog pair
    gconv_mut_rate          = 0.0003 // chance a site carries the donor base by plain substitution
    // Two copies losing the same bases at the same place is far longer odds than two copies
    // mutating to the same base, so a deletion marker is priced lower and is worth more.
    gconv_indel_factor      = 0.1    // a shared deletion against a shared substitution
    gconv_min_tract_af      = 0.25   // read fraction a tract needs before it is called
    gconv_min_mismap        = 0.2    // fitted donor-read fraction reported as mismapping
    gconv_min_sites         = 3      // diagnostic sites a pair needs before it is analysed at all
    gconv_min_depth         = 5      // depth below which a site is undetermined in the summaries
    gconv_min_bq            = 13     // base-quality floor when reading an allele off a read
    // Fraction of the DONOR's own reads carrying the ACCEPTOR's bases at which the event is an
    // exchange between the copies rather than a conversion of one by the other. Gene conversion
    // is non-reciprocal: the donor hands over a copy and keeps its own.
    gconv_reciprocal_af     = 0.5
    // Read across the cohort, where two questions a single sample cannot answer become answerable:
    // is a tract this isolate or the reference, and is a signal too weak to call alone the same
    // tract another sample calls outright.
    gconv_corroborated_bf   = 2.0    // BF a sub-threshold tract needs before another sample can vouch for it
    gconv_ubiquitous        = 0.9    // fraction of the cohort at which an event is a reference artifact
    gconv_cohort_min_samples = 5     // cohort size below which recurrence says too little to act on
    // A gene family reports one event once per relationship. Those pointing at the same stretch
    // of donor are redundancy; those pointing elsewhere are a real choice of source, settled by
    // evidence per marker when the reads can settle it and reported as ambiguous when they cannot.
    gconv_donor_margin      = 1.0    // log10 per marker the best donor must beat the next by

    // --- Kraken2 Settings ---
    // No default: point it at your own database (or a site profile's). Without one the
    // contamination screen is skipped and the report's taxonomy panel hides itself.
    kraken2_db      = null

    // Extra host paths a container must be able to see, comma separated and no spaces. Only the
    // site profiles use it, because only they bind anything: reads or references living outside
    // the paths a profile already lists are added here rather than by editing a tracked config.
    //
    //     -profile garnatxa --extra_binds /storage/some_group,/scr/someone_else
    //
    // An unbound path does not fail at submission. It fails inside the task, as a file that is
    // plainly there on the login node and absent to the tool that opens it.
    extra_binds     = ''
    krakentools_url = "https://raw.githubusercontent.com/jenniferlu717/KrakenTools/master/extract_kraken_reads.py"
    // Read the Kraken DB via mmap so parallel tasks SHARE it in RAM instead of each loading
    // the full DB. Big peak-memory saving; slightly slower per task on a cold page cache.
    kraken_memory_mapping = true

    // --- FastP Settings ---
    fastp_min_length = 35

    // --- Backbone & FreeBayes Settings ---
    allpos_min_cov             = 30
    allpos_max_depth           = 10000
    allpos_min_bq              = 20
    // Report the real (no-BAQ) depth in the backbone and mask (X) only the
    // sites where BAQ collapses a well-covered position down into a gap.
    mask_baq_dropouts          = true
    freebayes_ploidy           = 2
    freebayes_min_alt_count    = 2
    freebayes_min_alt_fraction = 0.05
    freebayes_min_map_qual     = 30
    freebayes_min_base_qual    = 20
    // Optional region-parallel FreeBayes: split the genome into chunks and call them
    // concurrently (faster on deep samples). Needs freebayes-parallel + fasta_generate_regions.py
    // + GNU parallel in the container. Results can differ slightly from single-threaded FreeBayes
    // at region boundaries (haplotype calling), so it is OFF by default.
    freebayes_parallel         = false
    freebayes_parallel_jobs    = 4         // concurrent region jobs (= cpu reservation when on)
    freebayes_parallel_chunk   = 500000    // region size in bp for fasta_generate_regions.py

    // --- VAF & Filters ---
    hom_threshold = 0.90
    het_min_frac  = 0.10
    filter_min_dp = 30
    min_alt_fwd   = 2
    min_alt_rev   = 2

    // --- Flags & Options ---
    exclude_repeats      = true
    // H37Rv Illumina "blind spots" (Zenodo 3701840): 3.62% of positions where short-read calling is
    // unreliable. Opt-in; when true the intervals are added to the per-reference exclusion (dropped from
    // variant calling + consensus + shown in the report mask panel), applied with the run's reference
    // contig name. Use ONLY with an H37Rv-coordinate reference (H37Rv / the MTBC ancestor share coords).
    mask_blindspots      = false
    blindspot_bed        = "${projectDir}/assets/H37Rv_blindspots.bed"
    // Lift the H37Rv blind-spots onto the run's reference with pathotypr classify (alignment-free k-mer
    // liftover, bin/pathotypr_liftover.py) so the mask is correct even when the reference does NOT share
    // H37Rv coordinates. Needs the pathotypr container. If false, the BED is appended directly (only correct
    // for an H37Rv-coordinate reference). canonical_ref = the FASTA the blind-spot coords are defined on.
    blindspot_liftover   = true
    canonical_ref        = "/opt/pathotypr/reference.fasta"   // MTBC-ancestor fasta (H37Rv-colinear); override with an H37Rv fasta if preferred
    // Report: fill each variant's reference-of-interest (H37Rv) COORDINATE with a pathotypr k-mer liftover
    // (alignment-free) instead of the Picard --vcfs-h37rv path. Opt-in; needs the pathotypr container.
    variant_liftover     = false
    make_consensus       = true
    annotate_legacy_vcfs = true
    annotate_main_vcf    = true
    bcftools_sort_mem    = "2G"
    // Also annotate each sample's variants against a second, CANONICAL reference snpEff DB so the report
    // shows the amino-acid change in both the used-reference and the canonical numbering (qc_report.py
    // --vcfs-h37rv). Defaults to H37Rv (MTB); change canonical_snpeff_db / canonical_label for another
    // organism, or set annotate_canonical=false to turn the dual numbering off. Only meaningful when the
    // mapping reference shares the canonical reference's coordinates.
    annotate_canonical   = false                               // master on/off switch for the dual numbering
    canonical_snpeff_db  = "Mycobacterium_tuberculosis_h37rv"  // any snpEff genome for the organism of interest
    canonical_label      = "H37Rv"                             // how that numbering is labelled in the report

    // --- Output publishing (disk footprint) ---
    // 'copy' (default) duplicates each output in outdir; 'link' hardlinks it to the work copy
    // (near-zero extra disk, survives work cleanup) when outdir and work share a filesystem.
    publish_mode             = 'copy'
    // With the length-aware filter on, filtered.bam is the analysis BAM and final.bam (pre-filter)
    // is a ~redundant second full BAM -> not published by default. Set true to keep it.
    publish_prefilter_bam    = false
    // Per-position VCFs (consensus substrate). Keep the masked one; the virgin (.raw) one is
    // redundant with the virgin consensus fasta, so it is off by default.
    publish_allpos_vcf       = true
    publish_virgin_allpos_vcf = false
    // Publish the alignment as CRAM (reference-compressed, ~40-50% smaller than BAM) instead of
    // BAM. Analysis stays on BAM internally (FreeBayes/mpileup unaffected); only the published
    // deliverable changes. Decoding needs the reference fasta; when on, reference.fa is also
    // published under references/<ref>/ so the outputs are self-decodable.
    output_cram              = false

    // --- Consolidated QC report (self-contained interactive HTML + qc_flags.tsv) ---
    make_qc_report      = true
    // Master SNP matrix TSV: rows = SNP sites, columns = reference/annotation + per-sample AF & depth.
    make_snp_matrix     = true
    report_gate         = false   // if true, fail the run when any sample is flagged FAIL
    report_depth_min    = 10      // PASS/WARN/FAIL thresholds (editable live inside the report)
    report_breadth_min  = 90
    report_missing_max  = 10
    report_dup_max      = 40
    report_iupac_max    = 2
    report_mapping_min  = 80

    // --- Consensus Settings ---
    consensus_wrap        = 80
    consensus_mask_char   = "X"
    consensus_nocall_char = "-"
    consensus_min_dp      = 7
    // Reference-bias gate: emit the reference base at a monomorphic site only with enough
    // base-supporting depth (RO+AO) and low alt fraction, else N. Set false to disable.
    consensus_ref_bias_gate   = true
    consensus_ref_min_dp      = 10
    consensus_max_ref_altfrac = 0.10
    consensus_max_ref_min_alt = 2
    consensus_max_ref_del_frac = 0.5   // at a monomorphic ref site, write N if >= this fraction of reads carry a deletion/skip

    // --- Length-aware read masking (genmap, per reference + per sample) ---
    // Drop reads too short to be uniquely placed at their locus (short-read false
    // positives in near-repeats). A fragment is kept if EITHER mate anchors uniquely.
    dynamic_read_filter   = true
    genmap_min_k          = 35        // smallest read length probed (matches fastp_min_length)
    genmap_max_k          = 150       // largest read length probed
    genmap_step           = 5         // k-sweep step (5 = fast/24 runs; 1 = max fidelity)
    genmap_errors         = 2         // mismatches per k-mer (paralog/sequencing tolerance)
    genmap_error_rate     = 0         // >0 -> E scales with k: E=max(1,round(k*rate)); 0 -> fixed genmap_errors
    genmap_infinity       = 65535     // uint16 sentinel = never unique -> always dropped
    genmap_tail_policy    = "keep"    // contig-end unscored positions: keep | drop
    filter_keep_unmapped  = false
    filter_strict_contigs = true      // fail if a BAM contig is missing from the track (else fail-open + warn)
    filter_max_drop_pct   = 8         // warn if a sample drops more than this % of reads (QC flag)

    // Persistent cache for the per-reference mappability track (computed once, reused across runs).
    // Point this at a shared/stable path; clear it if you change the reference or the genmap_* params.
    mappability_dir       = "mappability_cache"
    // Mark the always-repetitive interior (genmap-derived) as mask_char (X) in the masked consensus.
    mappability_mask_consensus = true

    // --- Virgin (unmasked) consensus ---
    keep_virgin_consensus = true      // also emit {sample}.{ref}.raw.consensus.fasta from the UNfiltered bam
    virgin_full_freebayes = false     // true -> re-call FreeBayes on the raw bam (shows pre-filter variants); false -> reuse masked SNPs
}

// 2. Singularity Configuration
// autoMounts binds the work and launch directories. Reads, references and the Kraken database
// usually live elsewhere on a shared filesystem, so a cluster needs its own --bind list: put it in
// a site profile (see conf/garnatxa.config) rather than here.
singularity {
    enabled    = true
    autoMounts = true
}

// 3. Process Execution Configuration
// Nothing in this block is site-specific. The executor, the queue/QoS and any `module load` belong
// to a profile, so a clone of this repository runs correctly anywhere without being edited.
process {
    executor       = 'local'

    // Note: resourceLimits is set at the BOTTOM of this file, after the profiles.

    // Container definition (pinned digest via params.container -> reproducible builds)
    container      = params.container

    // Error handling & Shell settings
    // Capture exit codes from upstream processes when piping
    shell          = ['/bin/bash', '-euo', 'pipefail']

    // Note: there is no `publishDirMode` process directive. The publish mode is user-selectable
    // via params.publish_mode, which every process passes to its own `publishDir mode:`.

    // Retry only on OOM (137/OOM-killer) or signal kills / preemption (SIGTERM 143,
    // SIGABRT 134, SIGSEGV 139, 140); genuine errors still fail fast. Processes whose
    // memory scales with task.attempt get more RAM on each retry.
    errorStrategy  = { task.exitStatus in [137, 140, 143, 134, 139] ? 'retry' : 'finish' }
    maxRetries     = 3

    // Hash inputs by name+size+timestamp instead of full content: on a shared HPC filesystem
    // this makes -resume faster and avoids re-hashing multi-GB BAMs (nf-core standard).
    cache          = 'lenient'
}

// 3b. Execution Reports
// Stable names under <outdir>/pipeline_info so reports live with the results and actually
// overwrite on re-run (Nextflow's default names are timestamped -> they pile up in the launch dir).
// trace.fields exposes the CPU%/RSS/IO columns needed to right-size cpus/memory from data.
timeline { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/execution_timeline.html" }
report   { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/execution_report.html" }
trace    {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/execution_trace.txt"
    fields    = 'task_id,hash,native_id,process,tag,name,status,exit,attempt,realtime,%cpu,peak_rss,peak_vmem,rchar,wchar'
}

// 3c. Lifecycle handlers: a one-line run summary to the console (status, duration, task tallies).
// (config-scope closures have no `log`, so use println/System.err.)
workflow.onComplete = {
    def st = workflow.stats
    println "BAMpiro ${workflow.runName}: ${workflow.success ? 'SUCCESS' : 'FAILED'} | " +
            "duration ${workflow.duration} | tasks ${st.succeededCount} ok, ${st.cachedCount} cached, " +
            "${st.failedCount} failed, ${st.ignoredCount} ignored | exit ${workflow.exitStatus}"
    if (workflow.success) {
        println "Results:   ${params.outdir}"
        if (params.make_qc_report) {
            // match Nextflow simpleName (strips from the FIRST dot) so this path equals the real
            // report filename even for multi-dot sheet names; file() is not available in config closures.
            def nm = new File(params.tsv as String).name
            def rn = nm.contains('.') ? nm.substring(0, nm.indexOf('.')) : nm
            println "QC report: ${params.outdir}/${rn}_qc_report.html"
        }
    } else {
        System.err.println "-------------------------------------------------------------------"
        System.err.println "BAMpiro failed. To find out why:"
        System.err.println "  1. Read the error just above - Nextflow names the failed process,"
        System.err.println "     its exit status, and the work directory of the failed task."
        System.err.println "  2. cd into that work dir and inspect:"
        System.err.println "       .command.err   (tool stderr)   .command.log  (combined log)"
        System.err.println "       .command.sh    (exact command)  .command.out  (tool stdout)"
        System.err.println "  3. Per-task exit codes, CPU and memory: ${params.outdir}/pipeline_info/execution_trace.txt"
        System.err.println "  4. Fix the cause, then re-launch with -resume to skip finished work."
        System.err.println "-------------------------------------------------------------------"
    }
}
workflow.onError = {
    System.err.println "BAMpiro ${workflow.runName} FAILED: ${workflow.errorReport ?: workflow.errorMessage}"
}

// 4. Execution Profiles
//
// WHERE the work runs is a profile, never a default. Pick one executor profile and combine it with
// as many option profiles as you like, comma-separated and with no spaces:
//
//     -profile local,docker            a laptop, with Docker
//     -profile slurm                   any SLURM cluster
//     -profile garnatxa                the I2SysBio cluster, with its paths already set
//     -profile slurm,generic           a SLURM cluster, non-tuberculosis organism
//
// With no -profile Nextflow applies `standard`, which runs everything on the current host.
profiles {
    // 'standard' = the default. Runs on THIS machine, so a fresh clone works anywhere without being
    // edited. On a cluster login node that means the login node, so choose an executor profile
    // deliberately for real work. The startup banner prints the executor it resolved.
    standard {
        process.executor = 'local'
    }
    // 'local' = an explicit alias for standard, for a command that says what it does.
    local {
        process.executor = 'local'
    }
    // 'slurm' = a generic SLURM cluster: no queue, no account and no module system assumed. Add your
    // site's QoS/partition and your Singularity --bind paths in a small -c config, or copy
    // conf/garnatxa.config as a starting point. See docs/tutorials/configuring-a-run.md.
    slurm {
        process.executor = 'slurm'
        executor {
            queueSize       = 100
            submitRateLimit = '50/1min'
            pollInterval    = '30s'
        }
    }
    // 'garnatxa' = the I2SysBio / University of Valencia cluster, ready to run as-is.
    garnatxa {
        includeConfig 'conf/garnatxa.config'
    }
    // 'docker' = use Docker instead of Singularity. On a laptop combine it with local: `-profile local,docker`.
    docker {
        singularity.enabled  = false
        docker.enabled       = true
        docker.runOptions    = '-u $(id -u):$(id -g)'
        process.beforeScript = ''
        // The pinned reference carries the `docker://` scheme, which is what Singularity wants
        // and what Docker refuses: it fails with `invalid reference format` before pulling
        // anything. The default keeps the scheme, because that is the path every cluster run
        // takes; this profile is the one that has to drop it.
        process.container    = params.container.replaceFirst(/^docker:\/\//, '')
    }
    // 'generic' = a NON-tuberculosis organism. BAMpiro's defaults are TB-tuned (diploid calling for mixed
    // infections + the MTBC-only features); this profile flips them to sane defaults for a clonal haploid
    // bacterium. Combine it with the executor profile, e.g. `-profile standard,generic`. For anything beyond
    // these essentials (Kraken DB, a canonical numbering, gate thresholds) copy conf/organism.config and add
    // it with `-c`. See docs/configuration.md ("Working with other organisms").
    generic {
        params.freebayes_ploidy   = 1        // haploid bacterium (TB default is 2, to catch mixed infections)
        params.run_pathotypr      = false    // MTBC lineage + WHO drug-resistance typing (Mycobacterium-only)
        params.variant_liftover   = false    // H37Rv coordinate liftover (MTBC-only)
        params.mask_blindspots    = false    // H37Rv Illumina blind-spots mask (MTBC-only)
        params.annotate_canonical = false    // dual H37Rv amino-acid numbering (set your own DB to re-enable)
    }
    // 'test' = the bundled fixture cohort (tests/data), sized for `-stub-run` so CI can validate the whole
    // DAG in seconds with no container and no reference data. 'test_full' additionally turns ON every
    // optional branch (Kraken, pathotypr, canonical annotation, liftover, virgin consensus) so a single run
    // instantiates every process. Launch both from the repository root:
    //     nextflow run main.nf -profile test -stub-run
    test {
        includeConfig 'conf/test.config'
    }
    test_full {
        includeConfig 'conf/test.config'
        includeConfig 'conf/test_full.config'
    }
    // You can add 'debug' or 'local' profiles here if needed in the future
}

// 5. Resource ceilings
// Deliberately AFTER the profiles: this reads params.max_*, and a profile that sets them (see
// conf/test.config) is only merged when its block is parsed. Evaluated higher up, a profile's
// ceilings would be silently ignored. An entry is dropped when its param is null, so an empty map
// means every process keeps the size it asked for.
process {
    resourceLimits = [
        cpus:   params.max_cpus   ? (params.max_cpus as int) : null,
        memory: params.max_memory ? (params.max_memory as nextflow.util.MemoryUnit) : null,
        time:   params.max_time   ? (params.max_time as nextflow.util.Duration) : null,
    ].findAll { k, v -> v != null }
}

// 6. Pipeline Metadata
manifest {
    name        = 'BAMpiro'
    author      = 'Paula Ruiz-Rodriguez (paula.ruiz.rodriguez@csic.es) / PathoGenOmics-Lab'
    description = 'Short Read mapping pipeline with Variant Calling'
    version     = '1.1.0'
    homePage    = 'https://github.com/PathoGenOmics-Lab/BAMpiro'
    mainScript  = 'main.nf'
    nextflowVersion = '!>=24.04.2'
}
